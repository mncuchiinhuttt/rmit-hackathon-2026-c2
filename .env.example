# Copy to .env. Never commit the populated .env.
# Explicit temporary simulation. Use tide to enable the real integration; no fallback occurs.
HUI_AUTH_MODE=simulated
# Persistent sample data only. Keep the database and its WAL/SHM sidecars private.
HUI_SIMULATION_DB_PATH=data/simulation.sqlite
TIDECLOAK_URL=http://localhost:8080
TIDE_REALM=hui-rmit26
TIDE_CLIENT_ID=hui-rmit26-client
TIDE_APP_ORIGIN=http://localhost:3000

# Credentials of your own localhost TideCloak development server.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# A real address controlled by the person managing the free-tier licence.
TIDE_LICENSE_EMAIL=
# Set to yes only after that person explicitly agrees to https://tide.org/legal.
TIDE_TERMS_ACCEPTED=

# Local-only submission details; semicolon-separated. Not sent by this command.
TEAM_EMAILS=
