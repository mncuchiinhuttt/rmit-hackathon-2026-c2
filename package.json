{
  "name": "hostless-hui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun run --bun next dev --webpack --hostname 127.0.0.1",
    "build": "bun run --bun next build --webpack",
    "start": "bun run --bun next start --hostname 127.0.0.1",
    "typecheck": "bun run --bun tsc --noEmit",
    "lint": "bun run --bun eslint .",
    "test": "bun test",
    "tide:provision": "bun scripts/tide/provision-realm.ts",
    "tide:verify": "bun scripts/tide/provision-realm.ts --verify",
    "tide:prepare": "bun scripts/tide/prepare-demo.ts",
    "tide:enroll": "bun scripts/tide/enrollment-links.ts",
    "tide:sync": "bun scripts/tide/sync-enrollment.ts",
    "tide:activate": "bun scripts/tide/activate-first-admin.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tidecloak/js": "0.14.33",
    "@tidecloak/nextjs": "0.14.17",
    "@tidecloak/react": "0.14.33",
    "@tideorg/js": "0.14.29",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "heimdall-tide": "0.14.41",
    "jose": "6.2.13",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.3",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "patchedDependencies": {
    "@tidecloak/js@0.14.33": "patches/@tidecloak%2Fjs@0.14.33.patch"
  }
}
